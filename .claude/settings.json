{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [],
  "permissions": {
    "allow": [
      "Read(./docs/**)",
      "Read(./.claude/**)",
      "Bash(scripts/evidence.sh *)",
      "Bash(scripts/final-check.py *)",
      "Bash(jsonresume validate *)",
      "Bash(jsonresume text *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(shellcheck *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc.local)",
      "Edit(./.envrc.local)",
      "Bash(secret reveal *)",
      "mcp__claude_ai_Google_Drive__share_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/evidence-digest.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
