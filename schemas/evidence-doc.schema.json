{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ismailkattakath/agentic-jobseek/schemas/evidence-doc.schema.json",
  "title": "Evidence document",
  "description": "One line of evidence/{approved,pending,rejected}.jsonl (docs/adr/0007). doc_id is the identity, content_hash = sha256(content) names one version. Kept flat (no $ref) so scripts/evidence-schema.py's fallback validator covers it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "content_hash",
    "title",
    "content",
    "doc_type",
    "source_class",
    "company",
    "repo",
    "period",
    "skills",
    "technologies",
    "domains",
    "author_confidence",
    "metadata",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "doc_id": {
      "description": "UUIDv7 (RFC 9562), minted once; stable across enrichments.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "content_hash": {
      "description": "sha256(content) in lowercase hex; evidence-schema.py also checks it matches.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "doc_type": {
      "type": "string",
      "enum": [
        "contribution",
        "hard_problem",
        "skill_evidence",
        "architecture_decision",
        "unique_strength",
        "subsystem",
        "cross_repo_theme",
        "repo_overview",
        "resume_corroboration"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": ["enterprise", "personal-project", "oss-contribution"]
    },
    "company": {
      "description": "May be empty for personal work.",
      "type": "string"
    },
    "repo": { "type": "string" },
    "period": {
      "description": "YYYY · YYYY-MM · YYYY..YYYY · YYYY..YYYY-MM · YYYY-MM..YYYY-MM · YYYY-MM..present · multi-year",
      "type": "string",
      "pattern": "^(multi-year|[0-9]{4}(-[0-9]{2})?(\\.\\.([0-9]{4}(-[0-9]{2})?|present))?)$"
    },
    "skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "technologies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "domains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "author_confidence": {
      "description": "The operator's handle (sole author) · mixed · teammate · unknown. The handle is per-operator, so it is not enumerated here.",
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "proposal": {
          "description": "Present only on a pending document (ADR-0007 § 3).",
          "type": "object",
          "additionalProperties": true
        },
        "enrichments": {
          "description": "Audit trail of approved enrichments.",
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "commit_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$"
    }
  }
}
