# direnv: this repo's per-operator settings, scoped to this directory.
# Run `direnv allow` once. Values never live here — see .envrc.local below.

use flake

dotenv_if_exists .env

# Per-operator, gitignored file pointing at the data folder (CLAUDE.md § Where the data lives):
#   export JOBSEEK_DRIVE_DIR="$HOME/Library/CloudStorage/GoogleDrive-<account>/My Drive/<job-search folder>"
# RAGDB_URI comes from the operator's environment, not from here.
source_env_if_exists .envrc.local
